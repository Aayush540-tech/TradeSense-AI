# TradeSense AI Configuration Environment Template

# Application
APP_NAME="TradeSense AI"
APP_ENV=development
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Redis / Google Cloud Memorystore
# For local dev: localhost:6379 (or leave blank to use fast in-memory fallback)
# For Cloud Run: IP of Memorystore instance (e.g. 10.x.x.x:6379)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_SSL=False

# Google Cloud & Vertex AI (Gemini 1.5 Flash / Pro)
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="asia-south1"
GEMINI_API_KEY="your-gemini-api-key-or-vertex-ai-token"
GOOGLE_APPLICATION_CREDENTIALS=""

# Broker WebSockets & Read-Only APIs (Select Dhan, Upstox, or Zerodha)
BROKER_PROVIDER="mock" # Options: 'mock', 'dhan', 'upstox', 'zerodha'

# Dhan HQ Credentials (if using Dhan)
DHAN_CLIENT_ID=""
DHAN_ACCESS_TOKEN=""

# Upstox Credentials (if using Upstox)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="http://localhost:8000/api/v1/auth/upstox/callback"

# Zerodha Kite Connect Credentials (if using Zerodha)
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
ZERODHA_ACCESS_TOKEN=""
